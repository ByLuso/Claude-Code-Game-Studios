[autoload]

Economia="*res://scripts/economia.gd"
Cultivos="*res://scripts/cultivos.gd"
Maquinas="*res://scripts/maquinas.gd"
Amenazas="*res://scripts/amenazas.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
